# 이 파일을 복사해서 .env로 이름을 바꾸고 실제 값을 채워 넣으세요.
# .env는 절대 git에 커밋하지 않습니다 (.gitignore에 포함).

# --- PostgreSQL (로컬 Compose 전용) ---
POSTGRES_DB=kokbaejeong
POSTGRES_USER=kokbaejeong_user
POSTGRES_PASSWORD=change_me

# --- OpenAI (Spring AI, 창고 혼잡도 요약) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- 관리자 JWT 서명 키 (32자 이상 임의 문자열 권장) ---
JWT_SECRET=change_me_to_a_long_random_string

# --- 프론트엔드가 바라볼 백엔드 주소 ---
# 로컬 개발: 비워두면 nginx 프록시(/api)를 통해 backend로 연결
# Railway 배포: 배포된 백엔드의 실제 URL을 입력 (예: https://kokbaejeong-backend.up.railway.app)
VITE_API_BASE_URL=
